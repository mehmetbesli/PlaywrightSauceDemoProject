{
  "name": "playwright-sauce-demo-project",
  "version": "1.0.0",
  "description": "E2E Test Automation Project with Playwright & TypeScript for Sauce Demo Shopify",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "test:debug": "playwright test --debug --project=chromium",
    "test:email": "cross-env SEND_EMAIL=true playwright test --project=chromium",
    "test:qa:email": "cross-env SEND_EMAIL=true ENV=qa playwright test --project=chromium",
    "test:dev:email": "cross-env SEND_EMAIL=true ENV=dev playwright test --project=chromium",
    "test:all-browsers:email": "cross-env SEND_EMAIL=true playwright test --project=chromium --project=firefox",
    "test:parallel": "playwright test --project=chromium --fully-parallel --workers=2",
    "test:parallel:4": "playwright test --project=chromium --fully-parallel --workers=4",
    "test:parallel:headed": "playwright test --project=chromium --headed --fully-parallel --workers=2",
    "test:serial": "playwright test --project=chromium --workers=1",
    "test:serial:headed": "playwright test --project=chromium --headed --workers=1",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:all-browsers": "playwright test --project=chromium --project=firefox",
    "test:all-browsers:headed": "playwright test --headed --project=chromium --project=firefox",
    "test:chrome:headed": "playwright test --project=chromium --headed",
    "test:firefox:headed": "playwright test --project=firefox --headed",
    "test:webkit:headed": "playwright test --project=webkit --headed",
    "test:dev": "cross-env ENV=dev playwright test --project=chromium",
    "test:qa": "cross-env ENV=qa playwright test --project=chromium",
    "test:staging": "cross-env ENV=staging playwright test --project=chromium",
    "test:prod": "cross-env ENV=prod playwright test --project=chromium",
    "test:qa:parallel": "cross-env ENV=qa playwright test --project=chromium --workers=2",
    "test:dev:parallel": "cross-env ENV=dev playwright test --project=chromium --workers=2",
    "test:qa:parallel:headed": "cross-env ENV=qa playwright test --project=chromium --headed --workers=2",
    "test:dev:parallel:headed": "cross-env ENV=dev playwright test --project=chromium --headed --workers=2",
    "test:dev:headed": "cross-env ENV=dev playwright test --project=chromium --headed",
    "test:qa:headed": "cross-env ENV=qa playwright test --project=chromium --headed",
    "test:staging:headed": "cross-env ENV=staging playwright test --project=chromium --headed",
    "test:prod:headed": "cross-env ENV=prod playwright test --project=chromium --headed",
    "report": "playwright show-report reports/html"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "e2e",
    "testing",
    "page-object-model",
    "multi-environment",
    "parallel-execution",
    "cross-browser",
    "email-reporting"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "nodemailer": "^6.10.0"
  }
}
